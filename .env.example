# ==============================================================================
# Samantha Core — Environment Configuration Template
# ==============================================================================

# Directory radice dell'ecosistema Samantha Core (default: directory del repository)
SAMANTHA_ROOT=/opt/samantha-core

# Configurazione Connessione PostgreSQL (Database State & A2A Ledger)
DATABASE_URL=postgresql://samantha_user:samantha_password@localhost:5432/samantha_db

# Engine CLI predefinito per nuovi agenti/exec ('agy', 'claude', 'qwen')
DEFAULT_ENGINE=agy

# Modello / Cascata predefinita ('cascata-fast', 'cascata-pro', 'flash', 'pro')
DEFAULT_MODEL=cascata-fast

# Livello di Logging ('DEBUG', 'INFO', 'WARNING', 'ERROR')
LOG_LEVEL=INFO

# ==============================================================================
# API Keys per Provider AI (Opzionali se si usa login OAuth CLI come Antigravity/Claude Code)
# ==============================================================================
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# TELEGRAM_BOT_TOKEN=...
